# FlashForge — Environment Variables
# Copy this file to .env.local (for local dev) or set these in Vercel project settings.
# All server-side image-search keys are optional. Openverse works without credentials.
# AI generation is BYOK: users enter their own AI provider key, base URL, and model in the app.

# ---------------------------------------------------------------------------
# Image search — optional server-side provider credentials
# ---------------------------------------------------------------------------

# Brave Search API — broad web image results
# Get a key at https://api.search.brave.com/
BRAVE_API_KEY=

# Pixabay — stock photos and illustrations
# Get a key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Pexels — stock photography
# Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Google Custom Search Engine — web image search
# Set up at https://programmablesearchengine.google.com/ and https://console.cloud.google.com/
GOOGLE_API_KEY=
GOOGLE_CX=

# No shared server-side AI key is supported by the public app.
# This is intentional: anonymous users must supply their own AI credentials.
