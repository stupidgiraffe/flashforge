# FlashForge — Environment Variables
# Copy this file to .env.local (for local dev) or set these in Vercel project settings.
# All image-search keys are optional — the AI agent will use whichever providers are configured.
# You can also enter any of these per-session in the "Image Search Settings" dialog.

# ---------------------------------------------------------------------------
# Image search — provider API keys (configure at least one for best results)
# ---------------------------------------------------------------------------

# Brave Search API — broadest "web-relevant" image results, great for characters & funny imagery
# Get a free key at https://api.search.brave.com/  (Data for Search plan covers images)
BRAVE_API_KEY=

# Pixabay — safe, royalty-free stock images; generous free tier; good for illustrations
# Get a free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Pexels — high-quality stock photos, always free
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Google Custom Search Engine — broad web image search (100 free queries/day)
# Set up at https://programmablesearchengine.google.com/ and https://console.cloud.google.com/
GOOGLE_API_KEY=
GOOGLE_CX=

# ---------------------------------------------------------------------------
# (Optional) Default AI provider — only needed if you want server-side AI
# without requiring users to enter their own BYOK key.
# Leave blank; users supply their key in the AI Flashcard Agent dialog.
# ---------------------------------------------------------------------------
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
